# Normaliza finales de línea para que Windows y Linux/Mac no generen diffs falsos
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.http text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

*.db   binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
